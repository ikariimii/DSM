diff --git a/lakebase/migrations/v1_7_007_qa056_unique_guards.sql b/lakebase/migrations/v1_7_007_qa056_unique_guards.sql
new file mode 100644
index 0000000..a360a94
--- /dev/null
+++ b/lakebase/migrations/v1_7_007_qa056_unique_guards.sql
@@ -0,0 +1,25 @@
+-- Lakebase migration v1_7_007 (QA-056, App Dev): at most one open row per key on the owner-owned tables, enforced by
+-- the database (belt and braces under the app's per-dam advisory lock + in-transaction re-checks):
+--   dam_cdse_outbox: one pending CDSE event per dam; dssmp_registration_outbox: one pending row per DSSMP version;
+--   ref_change_publication: one active (pending / applied) N+1 publication per rule version.
+-- The block is byte-identical to lakebase/001 (tests/test_lakebase_qa056_guards.py). Run as the deployer (member of
+-- dam_lakebase_owner). ORDER: after v1_7_006 (chain head log). IDEMPOTENT. Then run lakebase/validate_append_only.sql (0 rows).
+-- PRE-CHECK: CREATE UNIQUE INDEX fails on rows duplicated by the pre-fix race; find them first with
+--   SELECT dam_id, count(*) FROM dam_app.dam_cdse_outbox WHERE status = 'pending' GROUP BY 1 HAVING count(*) > 1;
+--   SELECT dssmp_version_id, count(*) FROM dam_app.dssmp_registration_outbox WHERE status = 'pending'
+--     GROUP BY 1 HAVING count(*) > 1;
+-- and resolve them through the publisher (mark the loser rejected_invalid) before re-running.
+-- DOWN: v1_7_007_qa056_unique_guards_down.sql (drops the three indexes only; no table, column or row).
+-- UNVERIFIED: not run on a Lakebase instance.
+SET search_path TO dam_app;
+BEGIN;
+-- BEGIN v1_7_007 block (QA-056 belt and braces on owner-owned tables; names and predicates = app/backend/repos/state.py
+-- UNIQUE_GUARDS / PUB_GUARD: the app creates the same indexes on the tables it owns and skips these)
+CREATE UNIQUE INDEX IF NOT EXISTS dam_cdse_outbox_one_pending ON dam_cdse_outbox (dam_id) WHERE status = 'pending';
+CREATE UNIQUE INDEX IF NOT EXISTS dssmp_outbox_one_pending ON dssmp_registration_outbox (dssmp_version_id)
+  WHERE status = 'pending';
+CREATE UNIQUE INDEX IF NOT EXISTS ref_change_publication_one_version ON ref_change_publication
+  (dam_id, (payload::jsonb ->> 'threshold_id'), (payload::jsonb -> 'insert' ->> 'threshold_version'))
+  WHERE kind = 'ref.threshold.new_version' AND status IN ('pending', 'applied');
+-- END v1_7_007 block
+COMMIT;
diff --git a/lakebase/migrations/v1_7_007_qa056_unique_guards_down.sql b/lakebase/migrations/v1_7_007_qa056_unique_guards_down.sql
new file mode 100644
index 0000000..95e7fea
--- /dev/null
+++ b/lakebase/migrations/v1_7_007_qa056_unique_guards_down.sql
@@ -0,0 +1,7 @@
+-- DOWN for v1_7_007 (QA-056): drops the three unique guard indexes; no table, column or row is touched.
+SET search_path TO dam_app;
+BEGIN;
+DROP INDEX IF EXISTS dam_cdse_outbox_one_pending;
+DROP INDEX IF EXISTS dssmp_outbox_one_pending;
+DROP INDEX IF EXISTS ref_change_publication_one_version;
+COMMIT;
diff --git a/tests/test_lakebase_qa056_guards.py b/tests/test_lakebase_qa056_guards.py
new file mode 100644
index 0000000..c39865a
--- /dev/null
+++ b/tests/test_lakebase_qa056_guards.py
@@ -0,0 +1,73 @@
+"""QA-056 (App Dev patch for the DA): the unique guard indexes on the owner-owned Lakebase tables. lakebase/001 and
+migration v1_7_007 carry the same block; names and predicates match the app's state.py; live: a fresh 001 has them,
+a second pending row is refused for the app role, and the down migration drops only the indexes."""
+import os
+import re
+import shutil
+import subprocess
+import uuid
+
+import pytest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+DDL = os.path.join(ROOT, "lakebase", "001_app_schema.sql")
+MIG = os.path.join(ROOT, "lakebase", "migrations", "v1_7_007_qa056_unique_guards.sql")
+DOWN = os.path.join(ROOT, "lakebase", "migrations", "v1_7_007_qa056_unique_guards_down.sql")
+STATE = os.path.join(ROOT, "app", "backend", "repos", "state.py")
+NAMES = ("dam_cdse_outbox_one_pending", "dssmp_outbox_one_pending", "ref_change_publication_one_version")
+
+
+def _block(path):
+    s = open(path).read()
+    return s[s.index("-- BEGIN v1_7_007 block"):s.index("-- END v1_7_007 block")]
+
+
+def test_001_and_the_migration_carry_the_same_block_matching_the_app():
+    blk = _block(DDL)
+    assert _block(MIG) == blk
+    st = open(STATE).read()
+    for name, table in (("dam_cdse_outbox_one_pending", "dam_cdse_outbox"),
+                        ("dssmp_outbox_one_pending", "dssmp_registration_outbox")):
+        cols = re.search(r'\("' + name + r'", "' + table + r'",\s*"([^"]+)"\)', st, re.S).group(1)
+        assert re.sub(r"\s+", " ", f"ON {table} {cols};") in re.sub(r"\s+", " ", blk), name
+    assert "payload::jsonb ->> 'threshold_id'" in st and "payload::jsonb ->> 'threshold_id'" in blk
+    assert "kind = '{PUB_KIND_THRESHOLD}' AND status IN ('pending', 'applied')" in st
+    assert "kind = 'ref.threshold.new_version' AND status IN ('pending', 'applied')" in blk
+    code = "\n".join(l for l in open(DOWN).read().splitlines() if not l.lstrip().startswith("--"))
+    assert not re.search(r"\bDROP (TABLE|COLUMN)\b|\bDELETE\b|\bTRUNCATE\b", code)
+    assert all(f"DROP INDEX IF EXISTS {n};" in code for n in NAMES)
+
+
+PG = os.environ.get("DAM_TEST_PG")
+live = pytest.mark.skipif(not PG or not shutil.which("psql"), reason="set DAM_TEST_PG (libpq conninfo) + psql")
+
+
+def _psql(conninfo, *args, env_extra=None):
+    return subprocess.run(["psql", conninfo, "-X", "-q", "-At", "-v", "ON_ERROR_STOP=1", *args],
+                          capture_output=True, text=True, env=dict(os.environ, **(env_extra or {})))
+
+
+@live
+def test_fresh_001_has_the_guards_and_the_app_role_cannot_insert_a_second_pending_row():
+    tag = uuid.uuid4().hex[:8]
+    db, app = f"lbq56_{tag}", f"lbq56_app_{tag}"
+    assert _psql(PG, "-c", f"CREATE DATABASE {db}", "-c", f"CREATE ROLE {app} LOGIN").returncode == 0
+    su, ap = f"{PG} dbname={db}", f"{PG} dbname={db} user={app}"
+    try:
+        r = _psql(su, "-f", DDL, env_extra={"PGOPTIONS": f"-c dam.app_role={app}"})
+        assert r.returncode == 0, r.stderr
+        have = set(_psql(su, "-c", "SELECT indexname FROM pg_indexes WHERE schemaname = 'dam_app'").stdout.split())
+        assert set(NAMES) <= have
+        row = ("INSERT INTO dam_app.dam_cdse_outbox (outbox_id, dam_id, kind, new_cdse_id, change_reason_code, "
+               "proposed_by, approved_by, approved_at, approval_record_hash, status) VALUES "
+               "('{0}', 'D1', 'assign', 'c@x', 'initial_appointment', 'a@x', 'a@x', 't', 'h', 'pending')")
+        assert _psql(ap, "-c", row.format("O1")).returncode == 0
+        dup = _psql(ap, "-c", row.format("O2"))
+        assert dup.returncode != 0 and "dam_cdse_outbox_one_pending" in dup.stderr
+        assert _psql(su, "-f", DOWN).returncode == 0
+        have = set(_psql(su, "-c", "SELECT indexname FROM pg_indexes WHERE schemaname = 'dam_app'").stdout.split())
+        assert not set(NAMES) & have
+        assert _psql(su, "-f", MIG).returncode == 0                       # re-apply restores (idempotent)
+        assert _psql(su, "-f", MIG).returncode == 0
+    finally:
+        _psql(PG, "-c", f"DROP DATABASE IF EXISTS {db} WITH (FORCE)", "-c", f"DROP ROLE IF EXISTS {app}")
