+def _app_already_patched(rev: str | None = None) -> bool:
+    """App Dev applied the patch (merged with QA-056's dam lock in append_chained): state.py carries its effect, so
+    the patch no longer applies forward. Then check the effect instead of the patch. rev=None reads the working tree
+    (what `git apply --check` sees); rev="HEAD" reads the committed file (what `git archive HEAD` exports)."""
+    if rev is None:
+        st = open(os.path.join(ROOT, "app", "backend", "repos", "state.py")).read()
+    else:
+        st = git_show_or_skip(ROOT, rev, "app/backend/repos/state.py")
+    code = "\n".join(l for l in st.splitlines() if not l.lstrip().startswith("#"))
+    return ("CHAIN_LOCK_CLASS" in code and "review_chain_head_log" in code and '"review_chain_head_log")' in code
+            and 'q("UPDATE {s}review_chain_head' not in code and '" FOR UPDATE"' not in code)
